# Copy this file to `.env` (same folder) and fill in your real values.
# .env is already git-ignored — never commit real credentials.

# --- Local Postgres (default, matches infra/docker-compose.yml) ---
# DATABASE_URL=postgresql+psycopg://tax_user:tax_pass@localhost:5432/tax_calculator

# --- AWS RDS PostgreSQL ---
# Replace <endpoint> with the RDS "Endpoint" value from the AWS Console
# (RDS -> Databases -> your-db-instance -> Connectivity & security tab).
# sslmode=require is recommended since RDS enforces TLS by default.
DATABASE_URL=postgresql+psycopg://tax_admin:YOUR_PASSWORD@<endpoint>:5432/tax_calculator?sslmode=require

# CORS allow-list for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
